# Postgres
POSTGRES_PASSWORD=change-me

# Backend
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# SMTP (optional - ohne diese Werte kann keine Rechnung per Mail versendet werden)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# Host-side readiness indicators only; never put repository passwords here.
OFFSITE_REPOSITORY_CONFIGURED=false
OFFSITE_PASSWORD_FILE_CONFIGURED=false

# Frontend
FRONTEND_PORT=8080

# Homer dashboard (optional host port; Caddy uses freelancer-dashboard:8080)
DASHBOARD_PORT=8081
