# Install as /etc/freelancer-backup.env, owned by the service user, mode 0600.
# Credentials remain in the referenced protected files, never in this file or Git.
RESTIC_REPOSITORY=rclone:gdrive:itmitalles-backups/freelancer
RESTIC_PASSWORD_FILE=/home/tim/.config/freelancer-backup/restic-password
RCLONE_CONFIG=/home/tim/.config/rclone/rclone.conf
FREELANCER_ENV_FILE=/opt/tracker/.env
LOCAL_EXPORT_ROOT=/home/tim/backups/freelancer/business
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=5
RESTIC_KEEP_MONTHLY=12
